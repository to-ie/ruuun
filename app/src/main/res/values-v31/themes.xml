<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12 and up draws this plain splash itself: Ruu's head on navy, in the colour
         of the inner halo ring, so the app's own animated splash carries straight on. -->
    <style name="Theme.Ruuun.Splash" parent="Theme.SplashScreen">
        <item name="android:windowSplashScreenBackground">@color/ic_launcher_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/splash_ring</item>
        <item name="postSplashScreenTheme">@style/Theme.Ruuun</item>
    </style>
</resources>
