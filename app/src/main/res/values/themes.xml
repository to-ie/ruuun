<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Light only for v1; the Compose theme owns every colour the app draws. -->
    <style name="Theme.Ruuun" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@color/ground</item>
        <item name="android:navigationBarColor">@color/ground</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
    </style>

    <!-- Shown while the app starts: the logo mark on brand navy, with the wordmark
         underneath on versions that support a branding image. -->
    <style name="Theme.Ruuun.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ic_launcher_background</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.Ruuun</item>
    </style>
</resources>
